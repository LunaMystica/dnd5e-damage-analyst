<section
  class="da-panel tab {{tab.cssClass}}"
  data-group="primary"
  data-tab="weapons"
>
  {{#if hasEntries}}
    <div class="da-weapon-summary">
      {{#if weaponSummary.hasActiveWeapons}}
        <span><strong>Selected attacks:</strong> {{weaponSummary.attackCount}}</span>
        <span><strong>Weapons used:</strong> {{weaponSummary.weaponCount}}</span>
        <span><strong>Combined Formula:</strong> <span class="da-mono">{{weaponSummary.combinedFormula}}</span></span>
        <span><strong>Total DPR:</strong> {{weaponSummary.dpr}}</span>
        <span><strong>Total Avg Damage:</strong> {{weaponSummary.avgDamage}}</span>
      {{else}}
        <span>No weapon attacks selected yet. Set one or more attack counts above 0 to include them.</span>
      {{/if}}
    </div>
    <div class="da-table-wrap">
      <table class="da-table da-table--weapons">
        <thead>
          <tr>
            <th class="da-col-name">Name</th>
            <th>Use</th>
            <th>Dmg type</th>
            <th>Formula</th>
            <th>Hit %</th>
            <th>Crit %</th>
            <th>Avg / hit</th>
            <th>Attacks</th>
            <th>DPR</th>
            <th>Range</th>
          </tr>
        </thead>
        <tbody>
          {{#each entries}}
            <tr>
              <td class="da-col-name">
                <div class="da-name-cell">
                  {{#if this.img}}<img class="da-icon" src="{{this.img}}" alt="">{{/if}}
                  <span class="da-name-text">{{this.name}}</span>
                </div>
              </td>
              <td>{{this.activation}}</td>
              <td class="da-type">{{this.damageType}}</td>
              <td class="da-mono">{{this.formula}}</td>
              <td>{{this.hitChance}}%</td>
              <td>{{this.critChance}}%</td>
              <td class="da-num">{{this.avgHit}}</td>
              <td>
                <input
                  class="da-weapon-attacks"
                  type="number"
                  min="0"
                  step="1"
                  value="{{this.attacks}}"
                  data-item-id="{{this.id}}"
                >
              </td>
              <td class="da-num da-dpr">{{this.dpr}}</td>
              <td class="da-mono">{{this.minDmg}}–{{this.maxDmg}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="da-empty">{{emptyMessage}}</p>
  {{/if}}
</section>
