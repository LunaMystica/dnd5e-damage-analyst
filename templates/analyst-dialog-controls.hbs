<div class="da-controls">

  <div class="da-control-row da-control-row--primary">
    <div class="da-field da-field--grow">
      <label for="da-actor-select"><i class="fa-solid fa-user"></i> Actor</label>
      <select id="da-actor-select">
        <option value="">— none —</option>
        {{#if playerActors.length}}
          <optgroup label="Players">
            {{#each playerActors}}
              <option value="{{this.id}}" {{#if (eq this.id ../selectedActorId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </optgroup>
        {{/if}}
        {{#if npcActors.length}}
          <optgroup label="NPCs">
            {{#each npcActors}}
              <option value="{{this.id}}" {{#if (eq this.id ../selectedActorId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </optgroup>
        {{/if}}
      </select>
      <button type="button" id="da-open-actor" class="da-icon-btn" title="Open this actor's sheet" {{#unless canOpenActor}}disabled{{/unless}}>
        <i class="fa-solid fa-up-right-from-square"></i>
      </button>
    </div>
    <label class="da-check da-check--inline" title="Include NPC actors in the selector">
      <input type="checkbox" id="da-include-npcs" {{#if includeNpcs}}checked{{/if}}>
      <i class="fa-solid fa-dragon"></i> NPCs
    </label>
    <button type="button" id="da-reset-counts" class="da-btn da-btn--subtle" title="Reset use counts for this actor">
      <i class="fa-solid fa-rotate-left"></i> Reset
    </button>
    <button type="button" id="da-export-macro" class="da-btn da-btn--primary" title="Save this setup as a reusable macro">
      <i class="fa-solid fa-file-export"></i> Export Macro
    </button>
  </div>

  <div class="da-control-row da-control-row--group">
    <label class="da-group-label"><i class="fa-solid fa-people-group"></i> Temp group</label>
    <div class="da-chips">
      {{#each tempGroupMembers}}
        <span class="da-chip">
          {{#if this.img}}<img class="da-icon" src="{{this.img}}" alt="">{{/if}}
          <span class="da-chip-name">{{this.name}}</span>
          <button type="button" class="da-chip-remove" data-actor-id="{{this.id}}" title="Remove from group" aria-label="Remove {{this.name}}">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </span>
      {{/each}}
      {{#unless tempGroupMembers.length}}
        <span class="da-hint">Add actors to analyse several at once — totals combine in the “All” tab.</span>
      {{/unless}}
    </div>
    <select id="da-temp-add" class="da-temp-add" title="Add an actor to the temporary group" {{#unless hasAddable}}disabled{{/unless}}>
      <option value="">+ Add actor…</option>
      {{#if addablePlayers.length}}
        <optgroup label="Players">
          {{#each addablePlayers}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </optgroup>
      {{/if}}
      {{#if addableNpcs.length}}
        <optgroup label="NPCs">
          {{#each addableNpcs}}<option value="{{this.id}}">{{this.name}}</option>{{/each}}
        </optgroup>
      {{/if}}
    </select>
    {{#if canCreateGroup}}
      <button type="button" id="da-create-group" class="da-btn" title="Save this temporary group as a real Group actor">
        <i class="fa-solid fa-people-group"></i> Save as group
      </button>
    {{/if}}
    {{#if tempGroupMembers.length}}
      <button type="button" id="da-temp-clear" class="da-btn da-btn--subtle" title="Clear temporary group">Clear</button>
    {{/if}}
  </div>

  <div class="da-control-row da-control-row--params">
    <div class="da-field">
      <label for="da-target-ac">Target AC</label>
      <input id="da-target-ac" type="number" min="1" max="40" value="{{targetAC}}">
    </div>
    <div class="da-field">
      <label for="da-crit-min">Crit on</label>
      <input id="da-crit-min" type="number" min="1" max="20" value="{{critMin}}">
      <span class="da-unit">+</span>
    </div>
    <div class="da-field">
      <label for="da-save-dc-override">Spell DC</label>
      <input id="da-save-dc-override" type="number" min="1" max="40" value="{{saveDCOverride}}" placeholder="auto">
    </div>
    <label class="da-check da-check--inline" title="Always show the activity name after the item name (on by default for Features)">
      <input type="checkbox" id="da-show-activity" {{#if showActivityName}}checked{{/if}}>
      <i class="fa-solid fa-tag"></i> Activity names
    </label>
    <label class="da-check" title="Treat every attack as a guaranteed critical hit">
      <input type="checkbox" id="da-force-crit" {{#if forceCrit}}checked{{/if}}>
      <i class="fa-solid fa-burst"></i> Force crits
    </label>
  </div>

</div>
