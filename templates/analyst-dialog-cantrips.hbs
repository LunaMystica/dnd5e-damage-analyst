<section
  class="da-panel tab {{tab.cssClass}}"
  data-group="primary"
  data-tab="cantrips"
>
  {{#if hasEntries}}
    {{> da-summary summary}}
    <div class="da-table-wrap">
      <table class="da-table da-table--spells">
        <thead>
          <tr>
            <th class="da-col-name">Name</th>
            <th>Use</th>
            <th>Range</th>
            <th>Dmg type</th>
            <th>Formula</th>
            <th>DC / Hit %</th>
            <th>Crit %</th>
            <th>Avg (fail)</th>
            <th>Avg (save)</th>
            <th>Count</th>
            <th>DPR</th>
            <th>Min–Max</th>
          </tr>
        </thead>
        <tbody>
          {{#each entries}}
            {{> da-spell-row this showOwner=../showOwner}}
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="da-empty">{{emptyMessage}}</p>
  {{/if}}
</section>
