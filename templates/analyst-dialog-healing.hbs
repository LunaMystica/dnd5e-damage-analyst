<section
  class="da-panel tab {{tab.cssClass}}"
  data-group="primary"
  data-tab="healing"
>
  {{#if hasEntries}}
    {{> da-summary summary}}
    <div class="da-table-wrap">
      <table class="da-table da-table--healing">
        <thead>
          <tr>
            <th class="da-col-name">Name</th>
            <th>Use</th>
            <th>Range</th>
            <th>Type</th>
            <th>Formula</th>
            <th>Avg / use</th>
            <th>Count</th>
            <th>Total Avg</th>
            <th>Min–Max</th>
          </tr>
        </thead>
        <tbody>
          {{#each entries}}
            {{> da-healing-row this showOwner=../showOwner}}
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="da-empty">{{emptyMessage}}</p>
  {{/if}}
</section>
